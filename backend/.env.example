# ======================================================================
# Sayak Grocery App - Environment Template (.env.example)
# Safe to commit to Git. Copy to .env and fill in your actual credentials:
#   cp .env.example .env
# ======================================================================

# Server Port
PORT=8080

# Supabase PostgreSQL Database Credentials
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JPA / Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIKARI_MAX_POOL_SIZE=5

# JWT Secret Key (HMAC-SHA256, at least 256 bits)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS

# JWT Token Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# OTP Configuration
OTP_DEV_MODE=true
OTP_EXPIRATION_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# SMS Gateway Configuration (Supported: MOCK, FAST2SMS, TWILIO)
SMS_PROVIDER=MOCK
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_PHONE=+1234567890

